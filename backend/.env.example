# HTTP server
APP_HOST=0.0.0.0
APP_PORT=3000
RUST_LOG=backend_api=info,tower_http=info

# Readiness checks
HEALTH_CHECK_TIMEOUT_MS=2000

# MySQL / SeaORM
DATABASE_URL=mysql://app:app@127.0.0.1:3306/app?ssl-mode=disabled
DATABASE_MIN_CONNECTIONS=0
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT_MS=2000

# Redis
REDIS_URL=redis://127.0.0.1:6379

# OpenSearch. Set both credential variables or leave both empty.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Docker Compose host port overrides
MYSQL_PORT=3306
REDIS_PORT=6379
OPENSEARCH_PORT=9200
API_PORT=3000

# Docker Compose development credentials
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

