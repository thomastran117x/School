# HTTP server
APP_HOST=0.0.0.0
APP_PORT=3000
RUST_LOG=backend_api=info,tower_http=info
# development = readable logs; staging/production = JSON logs
APP_ENV=development
SERVICE_NAME=school-api

# HTTP hardening. Set HTTP_HTTPS_ENABLED=true only when served over HTTPS (enables HSTS).
HTTP_HTTPS_ENABLED=false
HTTP_HSTS_MAX_AGE_SECS=31536000
HTTP_MAX_BODY_BYTES=1048576
# Prometheus metrics, served on a separate listener (never the public API port).
# A non-loopback METRICS_ADDR requires METRICS_BEARER_TOKEN (use a long random value).
METRICS_ENABLED=true
METRICS_ADDR=127.0.0.1:9090
METRICS_BEARER_TOKEN=
# CORS allowlist (exact origins, comma-separated; wildcards are rejected)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=authorization,content-type,x-request-id
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECS=600

# Rate limiting (token buckets in Redis, shared by all replicas).
# Auth limits may not exceed the general limits and always fail closed (503) if Redis is down.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_IP_CAPACITY=120
RATE_LIMIT_GENERAL_IP_REFILL_PER_MINUTE=120
RATE_LIMIT_AUTH_IP_CAPACITY=10
RATE_LIMIT_AUTH_IP_REFILL_PER_MINUTE=6
RATE_LIMIT_AUTH_ACCOUNT_CAPACITY=5
RATE_LIMIT_AUTH_ACCOUNT_REFILL_PER_MINUTE=1
RATE_LIMIT_FALLBACK_MAX_ENTRIES=10000
# Trusted reverse proxies (comma-separated IPs/CIDRs). Leave EMPTY unless the API is only
# reachable through proxies you control: X-Forwarded-For is honoured only from these peers.
TRUSTED_PROXY_CIDRS=

# Readiness checks
HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# MySQL / SeaORM. TLS is disabled only for this isolated local service.
DATABASE_URL=mysql://app:app@127.0.0.1:3306/app
DATABASE_MIN_CONNECTIONS=0
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_TLS_MODE=disabled
DATABASE_TLS_CA_PATH=

# Redis
# TLS is disabled only for this isolated local service.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_TLS_MODE=disabled
REDIS_TLS_CA_PATH=

# Refresh sessions
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_FAMILY_MAX_LIFETIME_SECONDS=2592000

# Course catalogue cache (staleness bound if an invalidation is missed)
COURSE_CACHE_DETAIL_TTL_SECONDS=300
COURSE_CACHE_LIST_TTL_SECONDS=60
COURSE_CACHE_NEGATIVE_TTL_SECONDS=30

# OpenSearch. Set both credential variables or leave both empty.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Docker Compose host port overrides
MYSQL_PORT=3306
REDIS_PORT=6379
OPENSEARCH_PORT=9200
API_PORT=3000

# Docker Compose development credentials
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

